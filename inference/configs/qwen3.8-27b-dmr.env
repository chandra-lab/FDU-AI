# Inference profile: Qwen3.8-27B served by Docker Desktop Model Runner (llama.cpp, CUDA).
# Read by scripts\gpu-check.ps1, start-inference.ps1, status.ps1, test-inference.ps1.
# Rationale and measurements: docs/model-configuration.md. Change a value -> re-run gpu-check.ps1.

TARGET_MODEL=Qwen/Qwen3.8-27B
TARGET_MODEL_DISPLAY_NAME=Qwen3.8-27B
# Docker Hub model artifact and the digest that was tested (tags are mutable; the digest is checked).
MODEL_REF=ai/qwen3.8:27b
MODEL_DIGEST=sha256:c3858e9716a395da25ba17d1f8e9eb7ff740a399fc5ff182ac99741ada149490
# Name the OpenAI-compatible API reports in /v1/models and expects in requests.
SERVED_MODEL_ID=docker.io/ai/qwen3.8:27b
QUANTIZATION=gguf-ud-q4_k_m

# --- Runtime configuration applied with `docker model configure` ---
# Total tokens in llama.cpp's unified KV cache, shared by its 4 parallel slots.
CONTEXT_SIZE=32768
# Keep the model resident; avoids a ~13 s reload for the first request after idle.
KEEP_ALIVE=-1

# --- Model Runner endpoints ---
# Host TCP port, bound by Docker Desktop to 127.0.0.1 only.
DMR_TCP_PORT=12434
# Base URL for containers (backend) on any Docker network.
DMR_CONTAINER_BASE_URL=http://model-runner.docker.internal/engines/v1

# --- Inputs for the compatibility check (gpu-check.ps1), measured 2026-11-17 ---
# VRAM held by the loaded model excluding KV cache: Q4_K_M weights + F16 vision projector
# + recurrent state for 4 slots + compute buffers (18.65 GiB at 32K context minus 2.0 GiB KV).
EST_BASE_GIB=16.6
# Full-attention KV cache in F16: 16 layers x 4 KV heads x 256 dim x (K+V) x 2 bytes.
KV_BYTES_PER_TOKEN=65536
# llama.cpp has no memory budget flag; keep this much VRAM free for the desktop to fluctuate.
# (On Windows/WDDM an overrun may silently spill into shared system memory instead of failing.)
VRAM_SAFETY_MARGIN_GIB=1.0
MIN_COMPUTE_CAPABILITY=7.5
