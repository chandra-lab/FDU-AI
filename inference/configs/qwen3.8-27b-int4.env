# Inference profile: target model Qwen/Qwen3.8-27B served from the RedHatAI INT4 (W4A16) build.
# Passed to the container with --env-file and read by gpu-check.ps1 / download-model.ps1.
# Rationale and VRAM math: docs/model-configuration.md. Change a value -> re-run gpu-check.ps1.

TARGET_MODEL=Qwen/Qwen3.8-27B
TARGET_MODEL_DISPLAY_NAME=Qwen3.8-27B
MODEL_REPO=RedHatAI/Qwen3.8-27B-INT4
# Pinned Hugging Face commit (verified 2026-11-17).
MODEL_REVISION=e45c27e8f463817db788d141a73a3c235a0a7c0c
QUANTIZATION=int4-w4a16-compressed-tensors
SERVED_MODEL_NAME=qwen3.8-27b

# --- Conservative serving limits for a 24 GB card that also drives the display ---
MAX_MODEL_LEN=16384
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=4096
# Fraction of TOTAL VRAM vLLM may claim; it must also be free at startup.
GPU_MEMORY_UTILIZATION=0.86
KV_CACHE_DTYPE=fp8
# Text-only serving: skips the vision tower (~0.9 GB) and its profiling memory.
LANGUAGE_MODEL_ONLY=true
# CUDA graph capture allocates outside the vLLM memory budget; start eager, tune later.
ENFORCE_EAGER=true
ENABLE_PREFIX_CACHING=true
REASONING_PARSER=qwen3
TOOL_CALL_PARSER=qwen3_coder
ENABLE_AUTO_TOOL_CHOICE=true

# --- Inputs for the compatibility check (gpu-check.ps1) ---
# Measured on V-OAK-106-02 with vLLM 0.34.0: "Model loading took 16.71 GiB" (text-only, no MTP head).
EST_WEIGHTS_GIB=16.7
# Measured: ~1.1 GiB non-torch (CUDA context) + 0.57 GiB peak activations at 4096 batched tokens, eager.
EST_RUNTIME_OVERHEAD_GIB=1.7
# Full-attention KV: 16 layers x 4 KV heads x 256 dim x (K+V) x 1 byte (fp8).
KV_BYTES_PER_TOKEN=32768
# Gated DeltaNet recurrent state per sequence: 48 layers x 48 heads x 128 x 128 x fp32 + conv state.
STATE_BYTES_PER_SEQ=153900000
# Weight-only INT4 runs on Marlin kernels (sm_80+). sm_120 = RTX PRO 4000 Blackwell.
MIN_COMPUTE_CAPABILITY=8.0
# Download size (19.45 GB weights + tokenizer) plus margin.
REQUIRED_DISK_GB=25
