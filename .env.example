# University AI Platform - environment template.
# scripts\setup.ps1 copies this to .env and generates secrets. Never commit .env.
# Values below are non-secret defaults; secrets must be set in .env only.

# --- Host paths and networking -------------------------------------------
UAI_DATA_ROOT=C:\university-ai
UAI_NETWORK=university-ai

# Pinned image used by gpu-check.ps1 to verify GPU passthrough (tested 2026-11-17).
CUDA_TEST_IMAGE=nvidia/cuda:13.0.2-base-ubuntu24.04

# --- Inference (vLLM) ---------------------------------------------------
# Base image is pinned; never use :latest. See docs/model-configuration.md.
INFERENCE_BASE_IMAGE=vllm/vllm-openai:v0.34.0
INFERENCE_IMAGE=university-ai/inference:0.1.0-vllm0.34.0
INFERENCE_CONTAINER=university-ai-inference
# File name (without .env) under inference/configs/.
INFERENCE_PROFILE=qwen3.8-27b-int4
# Port published on 127.0.0.1 only, for local testing. Leave empty to publish nothing
# (the backend reaches the container over the private Docker network).
INFERENCE_HOST_PORT=8000
# Bearer key required by the vLLM OpenAI-compatible API. setup.ps1 generates one.
INFERENCE_API_KEY=CHANGE_ME
# Seconds start-inference.ps1 waits for /health before giving up.
INFERENCE_STARTUP_TIMEOUT=1200

# --- Hugging Face ---------------------------------------------------------
# Optional; only needed for gated repos or higher rate limits. Set in .env.
HF_TOKEN=
