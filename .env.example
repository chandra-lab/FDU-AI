# University AI Platform - environment template.
# scripts\setup.ps1 copies this to .env. Never commit .env.
# Values below are non-secret defaults; secrets must be set in .env only.

# --- Host paths and networking -------------------------------------------
UAI_DATA_ROOT=C:\university-ai
UAI_NETWORK=university-ai

# Pinned images used by the check scripts (tested 2026-11-17).
CUDA_TEST_IMAGE=nvidia/cuda:13.0.2-base-ubuntu24.04
NET_TEST_IMAGE=python:3.13-slim@sha256:e48f59cdba69a3cbd9ed2cf0f348d90d45a8d350d98134cf1070bc106ee9ed90

# --- Inference (Docker Desktop Model Runner) ------------------------------
# File name (without .env) under inference/configs/.
INFERENCE_PROFILE=qwen3.8-27b-dmr
# Seconds start-inference.ps1 waits for the model to load and answer.
INFERENCE_STARTUP_TIMEOUT=300
